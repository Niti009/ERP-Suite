# Local development defaults (never put production credentials here)
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
MEDIA_ROOT=

# SMTP settings; local DEBUG mode uses Django's console email backend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20
EMPLOYEE_INVITATION_EXPIRY_HOURS=72
